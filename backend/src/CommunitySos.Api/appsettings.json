{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },

  "ConnectionStrings": {
    "Sql": ""
  },

  "Jwt": {
    "Issuer": "community-sos-api",
    "Audience": "community-sos-mobile",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SigningKeyPem": ""
  },

  "Firebase": {
    "ProjectId": "",
    "ServiceAccountJson": "",
    "UseDevelopmentVerifier": false
  },

  "App": {
    "PolicyVersion": "2026-11",
    "MinimumAppVersion": { "Android": "1.0.0", "Ios": "1.0.0" },
    "EmergencyNumbers": [
      { "Label": "National Emergency", "Number": "112" },
      { "Label": "Ambulance", "Number": "108" },
      { "Label": "Fire", "Number": "101" },
      { "Label": "Police", "Number": "100" },
      { "Label": "Women Helpline", "Number": "1091" }
    ],
    "GrievanceContactEmail": "",
    "InviteLinkBaseUrl": "https://sos.example.com"
  },

  "BlobStorage": {
    "ServiceUri": null,
    "ConnectionString": "",
    "ContainerName": "sos-media",
    "ReadSasMinutes": 5
  },

  "GoogleMaps": {
    "ApiKey": "",
    "Language": "en",
    "Region": "in"
  },

  "Sos": {
    "EscalationMinutes": 3,
    "PendingExpiryHours": 24,
    "ApprovedExpiryHours": 24
  },

  "Alerts": {
    "RadiusMeters": 5000,
    "FreshHours": 12,
    "MaxAccuracyMeters": 500,
    "MaxAttempts": 5,
    "TimeToLiveMinutes": 30
  },

  "Retention": {
    "SosMediaDays": 90,
    "AuditLogDays": 365,
    "EndedSessionDays": 30,
    "InactiveDeviceDays": 90,
    "StaleLocationHours": 48,
    "BatchSize": 1000
  },

  "Jobs": {
    "Storage": "SqlServer",
    "RunServer": true
  },

  "Seed": {
    "MasterAdmin": { "PhoneNumber": "", "FullName": "Master Admin" }
  },

  "ForwardedHeaders": { "TrustAllProxies": false },
  "OpenApi": { "EnableUi": false },
  "AllowedHosts": "*"
}
