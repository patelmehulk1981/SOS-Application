# Copy to .env.local (git-ignored) and adjust. Expo inlines EXPO_PUBLIC_* values into the JS bundle,
# so never put secrets here.

# API root (without /api/v1). Android emulator: http://10.0.2.2:5180. Physical phone: http://<your-PC-LAN-IP>:5180.
# Start the API with:  dotnet run --project backend/src/CommunitySos.Api --launch-profile mobile-dev
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5180

# firebase = real OTP via Firebase Phone Auth (needs google-services files, see README).
# dev      = no SMS: any number, OTP 123456; the API must run with Firebase:UseDevelopmentVerifier=true.
#            Only honoured in debug builds.
EXPO_PUBLIC_AUTH_MODE=dev

# Public pages linked from the consent screen.
EXPO_PUBLIC_PRIVACY_URL=https://sos.example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://sos.example.com/terms

# Build-time only (app.config.ts)
INVITE_LINK_HOST=sos.example.com
# GOOGLE_SERVICES_JSON=./firebase/google-services.json
# GOOGLE_SERVICE_INFO_PLIST=./firebase/GoogleService-Info.plist
# Admin SOS map (Google Maps SDK keys; restrict them in Google Cloud to the app id + signing SHA-1 / bundle id).
# Without them the map screen shows a notice instead. Required for preview and production builds.
# GOOGLE_MAPS_ANDROID_API_KEY=
# GOOGLE_MAPS_IOS_API_KEY=
